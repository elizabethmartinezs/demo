            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { crearLibro(input: { titulo: \\\"El túnel\\\", autor: \\\"Sabato\\\", paginas: 160 }) { id titulo autor paginas } }\"\n}"
